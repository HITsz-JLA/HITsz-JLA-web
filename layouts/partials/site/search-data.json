{{- $pages := slice -}}{{- range .Site.RegularPages.ByDate.Reverse -}}{{- if in (slice "news" "events" "lyrics" "readings" "grammar" "grammarpoints" "grammarlevel") .Section -}}{{- $section := .Section -}}{{- if in (slice "grammarpoints" "grammarlevel") $section -}}{{- $section = "grammar" -}}{{- end -}}{{- $pages = $pages | append (dict "title" .Title "url" .RelPermalink "date" (.Date.Format "2006-01-02") "section" $section "level" (.Params.grammarlevel | default "") "text" ((printf "%s %s %s" .Plain (.Params.explanation | default "" | plainify) (.Params.connection | default "" | plainify)) | htmlUnescape)) -}}{{- end -}}{{- end -}}{{- with .Site.GetPage "/about/about" -}}{{- $joined := .Plain -}}{{- with $.Site.GetPage "/join/join" -}}{{- $joined = printf "%s %s" $joined .Plain -}}{{- end -}}{{- $pages = $pages | append (dict "title" "关于&加入" "url" ("/about/" | relURL) "date" (.Date.Format "2006-01-02") "section" "about" "level" "" "text" $joined) -}}{{- end -}}{{- $pages | jsonify -}}
